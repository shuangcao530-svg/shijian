#!/bin/bash
# Maven Wrapper for Windows Git Bash
MAVEN_PROJECTBASEDIR=$(cd "$(dirname "$0")"; pwd)
WRAPPER_DIR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper"
WRAPPER_JAR="$WRAPPER_DIR/maven-wrapper.jar"
WRAPPER_PROPERTIES="$WRAPPER_DIR/maven-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    java -cp "$WRAPPER_DIR/Downloader.jar" Downloader "$WRAPPER_JAR" "$(grep wrapperUrl "$WRAPPER_PROPERTIES" | cut -d= -f2)"
fi

# Parse distributionUrl
DIST_URL=$(grep distributionUrl "$WRAPPER_PROPERTIES" | cut -d= -f2-)
MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"

exec java -classpath "$WRAPPER_JAR" org.apache.maven.wrapper.MavenWrapperMain \
    -Dmaven.multiModuleProjectDirectory="$MAVEN_PROJECTBASEDIR" \
    "$@"
